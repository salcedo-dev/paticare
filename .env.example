# Copia este archivo como .env y pon tu propia clave (gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Modelos en orden de uso: si uno se queda sin cupo diario o falla, se prueba el siguiente.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite
# Opcional: 1 = mostrar el texto de los mensajes en la terminal (solo para depurar)
# PATI_DEBUG=1
